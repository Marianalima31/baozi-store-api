              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"ID retornado confere\", () => {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"produtoId\")));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Consultar Pedido",
      "request": {
        "method": "GET",
        "header": [],
