            ]
          }
        }
      ]
    },
    {
      "name": "13 Verificar exclusão de Pedido",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Verificar exclusão de Produto",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/{{produtoId}}"
      },
      "event": [
        {
