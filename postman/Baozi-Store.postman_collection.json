      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"ID retornado confere\", () => {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"pedidoId\")));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Excluir Pedido",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Resposta sem corpo\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Excluir Produto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/{{produtoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Resposta sem corpo\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Excluir Cliente",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/clientes/{{clienteId}}"
